# ---------------------------------
# Ghostty Configuration
# ---------------------------------

# -----------------
# Fonts & Appearance
# -----------------
font-family = FiraCode Nerd Font Mono
font-size = 18

# -----------------
# Window
# (window height is rarely an exact multiple of the cell height; by default
# the top-left cell hugs the edge and the whole remainder pools at the bottom
# and right, leaving a dead strip under zellij's status bar)
# -----------------
window-padding-balance = true
# Paint what's left with the terminal background. `extend` used the nearest
# row's color instead, which stretched zellij's status bar background into the
# padding and made the bar look one and a half rows tall.
window-padding-color = background
# Resize the window in whole cells so there's little padding to begin with.
# macOS only.
window-step-resize = true

# -----------------
# Cursor
# -----------------
cursor-style = bar

# -----------------
# Theme (auto light/dark, follows macOS system appearance)
# -----------------
theme = light:onelight-custom,dark:onedark-custom

# background-opacity = 0.7

# -----------------
# Bell (BEL from shell/readline on e.g. Delete past end of line — no bell
# icon in the title, no dock bounce, no sound)
# -----------------
bell-features = no-system,no-audio,no-attention,no-title,no-border

# -----------------
# macOS integration
# -----------------
macos-option-as-alt = true
macos-icon = chalkboard

# -----------------
# Clipboard
# -----------------
clipboard-read = allow
clipboard-write = allow

# -----------------
# Key Bindings
# (cmd+1-9 goto_tab, cmd+t new_tab, cmd+enter fullscreen, and
# super+left/right/backspace word-jump/delete are Ghostty defaults already)
# -----------------
keybind = super+s=close_tab:this
keybind = alt+backspace=text:\x17
keybind = ctrl+ш=text:\x09
keybind = ctrl+щ=text:\x0f
