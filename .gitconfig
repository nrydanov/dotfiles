# This is Git's per-user configuration file.
[user]
    email = find.art.in.living@gmail.com
[push]
    autoSetupRemote = true
    default = current
[fetch]
    prune = true
[pull]
    rebase = true
[alias]
    ch = "!fn() { git branch | fzf | xargs git checkout;}; fn"
    s = status
    c = commit
[init]
    defaultBranch = main
[rerere]
    enabled = true
    autoupdate = true
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
