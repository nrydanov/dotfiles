layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                // ANSI palette indices instead of hex: the terminal resolves them
                // from its current theme, so the bar follows light/dark switching.
                // No fg at all (active tab) means the terminal's default text color.
                color_normal     "2"
                color_accent     "4"
                color_tmux       "3"
                color_locked     "8"
                color_session    "4"
                color_border     "8"
                color_tab        "8"
                color_git        "4"
                color_date       "8"
                color_work       "4"

                format_left   "{mode} #[fg=$session,bold]{session}"
                format_center "{tabs}"
                format_right  "{command_worktime}{datetime}"
                format_space  ""

                // Without this the whole bar goes blank when content exceeds
                // the terminal width; instead drop parts, keeping tabs first,
                // then mode/session, dropping worktime/clock soonest.
                format_hide_on_overlength "true"
                format_precedence         "clr"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=$border]{char}"
                border_position "top"

                hide_frame_for_single_pane "false"

                mode_normal        "#[fg=$normal,bold] NORMAL "
                mode_locked        "#[fg=$locked,bold] LOCKED "
                mode_resize        "#[fg=$accent,bold] RESIZE "
                mode_pane          "#[fg=$accent,bold] PANE "
                mode_tab           "#[fg=$accent,bold] TAB "
                mode_scroll        "#[fg=$accent,bold] SCROLL "
                mode_enter_search  "#[fg=$accent,bold] ENT-SEARCH "
                mode_search        "#[fg=$accent,bold] SEARCH "
                mode_rename_tab    "#[fg=$accent,bold] RENAME-TAB "
                mode_rename_pane   "#[fg=$accent,bold] RENAME-PANE "
                mode_session       "#[fg=$accent,bold] SESSION "
                mode_move          "#[fg=$accent,bold] MOVE "
                mode_prompt        "#[fg=$accent,bold] PROMPT "
                mode_tmux          "#[fg=$tmux,bold] TMUX "

                tab_normal   "#[fg=$tab] {name} "
                tab_active   "#[bold,italic] {name} "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=$git] {stdout} "
                command_git_branch_interval    "1"
                command_git_branch_rendermode  "static"

                // Time worked today, from zellij/scripts/worktime.sh. zjstatus
                // runs commands without a shell, so `bash -c` is needed for ~.
                command_worktime_command    "bash -c \"~/.config/zellij/scripts/worktime.sh\""
                command_worktime_format     "#[fg=$work,bold] {stdout} "
                command_worktime_interval   "60"
                command_worktime_rendermode "static"

                // The WASM sandbox can't read the system timezone, so it must
                // be named explicitly.
                datetime          "#[fg=$date,bold] {format} "
                datetime_format   "%H:%M"
                datetime_timezone "Europe/Samara"
            }
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
